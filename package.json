{
    "name": "call-pool",
    "version": "0.9.0",
    "description": "HTTP request pool con rate limiting, retry e adaptive throttling",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./impit": {
            "types": "./dist/transports/impit.d.ts",
            "import": "./dist/transports/impit.js",
            "default": "./dist/transports/impit.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.17"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "pnpm build",
        "prepublishOnly": "pnpm build",
        "demo": "tsx demo.ts",
        "bench": "tsx bench-adaptive.ts",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "test:ui": "vitest --ui",
        "test:run": "vitest run && pnpm test:types",
        "test:types": "tsc --project tests/types/tsconfig.json",
        "typecheck": "tsc --noEmit",
        "test:e2e": "vitest run tests/e2e"
    },
    "keywords": [
        "http",
        "pool",
        "rate-limit",
        "throttle",
        "retry",
        "undici",
        "impit",
        "transport"
    ],
    "author": "Andrea Moraglia (https://github.com/Loykos)",
    "license": "MIT",
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Loykos/call-pool.git"
    },
    "bugs": {
        "url": "https://github.com/Loykos/call-pool/issues"
    },
    "homepage": "https://github.com/Loykos/call-pool#readme",
    "dependencies": {
        "undici": "^6.28.1"
    },
    "peerDependencies": {
        "impit": ">=0.14.0 <1"
    },
    "peerDependenciesMeta": {
        "impit": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@vitest/coverage-v8": "^3.2.7",
        "impit": "0.14.7",
        "tsx": "^4.7.0",
        "typescript": "^5.0.0",
        "vitest": "^3.2.7"
    }
}
