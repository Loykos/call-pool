{
    "name": "call-pool",
    "version": "0.1.0",
    "description": "HTTP request pool con rate limiting, retry e adaptive throttling",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/index.js",
        "dist/index.js.map",
        "dist/index.d.ts",
        "dist/index.d.ts.map",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.17"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "pnpm build",
        "prepublishOnly": "pnpm build",
        "demo": "tsx demo.ts",
        "bench": "tsx bench-adaptive.ts",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "test:ui": "vitest --ui",
        "test:run": "vitest run"
    },
    "keywords": [
        "http",
        "pool",
        "rate-limit",
        "throttle",
        "retry",
        "undici"
    ],
    "author": "Andrea Moraglia (https://github.com/Loykos)",
    "license": "MIT",
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Loykos/call-pool.git"
    },
    "bugs": {
        "url": "https://github.com/Loykos/call-pool/issues"
    },
    "homepage": "https://github.com/Loykos/call-pool#readme",
    "dependencies": {
        "undici": "^6.19.8"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@vitest/coverage-v8": "^1.6.0",
        "tsx": "^4.7.0",
        "typescript": "^5.0.0",
        "vitest": "^1.6.0"
    }
}
